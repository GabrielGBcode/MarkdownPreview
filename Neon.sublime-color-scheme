{
    "name": "Neon",
    "variables": {
        "bg": "#0d0f14",
        "panel": "#171b24",
        "fg": "#e6e6e6",
        "cyan": "#00e5ff",
        "pink": "#ff4081",
        "lime": "#c6ff00",
        "amber": "#ffd740",
        "blue": "#40c4ff",
        "violet": "#b388ff",
        "muted": "#7d8590",
        "sel": "#1e2d44"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(cyan)",
        "line_highlight": "#141922",
        "selection": "var(sel)",
        "selection_border": "var(sel)",
        "inactive_selection": "#171f2d",
        "gutter": "var(bg)",
        "gutter_foreground": "#4a5260",
        "gutter_foreground_highlight": "var(fg)",
        "find_highlight": "var(amber)",
        "find_highlight_foreground": "#000000",
        "misspelling": "var(pink)",
        "guide": "#232a36",
        "active_guide": "#3a4354",
        "stack_guide": "#2d3646",
        "accent": "var(cyan)",
        "brackets_foreground": "var(cyan)",
        "bracket_contents_foreground": "var(cyan)",
        "tags_foreground": "var(pink)"
    },
    "rules": [
        {"scope": "comment, punctuation.definition.comment", "foreground": "var(muted)", "font_style": "italic"},
        {"scope": "string, punctuation.definition.string", "foreground": "var(lime)"},
        {"scope": "constant.numeric, constant.language, constant.character, constant.other", "foreground": "var(violet)"},
        {"scope": "keyword, storage, storage.type, storage.modifier", "foreground": "var(pink)"},
        {"scope": "keyword.operator, punctuation.separator, punctuation.terminator", "foreground": "#9aa4b2"},
        {"scope": "entity.name.function, support.function, meta.function-call", "foreground": "var(blue)"},
        {"scope": "entity.name.class, entity.name.type, entity.other.inherited-class, support.class, support.type", "foreground": "var(cyan)"},
        {"scope": "variable.parameter", "foreground": "var(amber)", "font_style": "italic"},
        {"scope": "variable.language, variable.other.constant", "foreground": "var(violet)"},
        {"scope": "entity.name.tag", "foreground": "var(pink)"},
        {"scope": "entity.other.attribute-name", "foreground": "var(amber)"},
        {"scope": "invalid", "foreground": "#ffffff", "background": "var(pink)"},

        {"scope": "markup.heading, entity.name.section", "foreground": "var(cyan)", "font_style": "bold"},
        {"scope": "markup.heading.2", "foreground": "var(pink)", "font_style": "bold"},
        {"scope": "markup.heading.3, markup.heading.4, markup.heading.5, markup.heading.6", "foreground": "var(lime)", "font_style": "bold"},
        {"scope": "markup.bold", "foreground": "var(amber)", "font_style": "bold"},
        {"scope": "markup.italic", "foreground": "var(violet)", "font_style": "italic"},
        {"scope": "markup.raw, markup.inline.raw", "foreground": "var(amber)", "background": "var(panel)"},
        {"scope": "markup.underline.link, markup.underline.link.image", "foreground": "var(blue)"},
        {"scope": "markup.quote", "foreground": "var(violet)", "font_style": "italic"},
        {"scope": "markup.list punctuation.definition, punctuation.definition.list_item", "foreground": "var(pink)"},
        {"scope": "markup.inserted", "foreground": "var(lime)"},
        {"scope": "markup.deleted", "foreground": "var(pink)"},
        {"scope": "markup.changed", "foreground": "var(amber)"}
    ]
}
